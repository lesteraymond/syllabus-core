# STAGING environment template. Names and rules only: every <...> is a value the system owner supplies. Never commit a filled copy.
# Create a NEW staging file; do not copy the development server/.env. Check it with:
#   node scripts/vpaa-v2-preflight.cjs --env-file <your staging file>
#   node scripts/credential-readiness.cjs --env-file <your staging file>
NODE_ENV=staging
PORT=<port the Node process listens on behind the proxy>
APP_URL=<staging frontend URL, https>

# Dedicated STAGING database (never the development or production one). A least-privilege user, NOT root, with a non-empty password.
DB_HOST=<staging database host>
DB_NAME=<staging database name>
DB_USER=<least-privilege staging user>
DB_PASS=<non-empty password>
# The database server must allow packets of at least 16 MB (max_allowed_packet=16M): a checking report is stored in one statement. See docs/deployment/DATABASE-REQUIREMENTS.md.

# Signing secrets: 32+ random characters each, different from each other and from every other environment.
SESSION_SECRET=<new>
JWT_SECRET=<new>

# Host layer (see docs/vpaa-conformance/POLICY-V2-ACTIVATION.md section 2a). No domain is built into the code.
CORS_ALLOWED_ORIGINS=<the staging FRONTEND origin: https://host[:port], no path, no trailing slash>
TRUST_PROXY=<number of reverse-proxy hops in front of this server, usually 1>
SESSION_COOKIE_SAMESITE=<lax if the frontend and the API share a site; none only if they do not>

# Policy V2 + Claude Sonnet 5.5 (staging only)
SYLLABUS_CHECK_ACADEMIC_V2=on
SYLLABUS_CHECK_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=<a NEW staging key, in its own workspace, with a HARD spend limit set at the provider>
ANTHROPIC_MODEL=claude-sonnet-5-5
SYLLABUS_CHECK_ANTHROPIC_APPROVED_MODEL=claude-sonnet-5-5
SYLLABUS_CHECK_AI_GATE=advisory
SYLLABUS_CHECK_AI_MAX_REQUESTS=120
SYLLABUS_CHECK_AI_MAX_COST_USD=10
# The controlled COMPREHENSIVE-profile test (docs/checker-comprehensive/live/LIVE-TEST-PLAN.md) uses these INSTEAD of the two lines above: the profile reserves about
# $13.3 per check (a reservation ceiling, not dollars spent), so the cap must be at least 17. The real dollars are bounded separately (evaluation guard, spend register,
# provider-side limit). Leave SYLLABUS_CHECK_ACADEMIC_V2 unset: the profile turns Policy V2 and the stages on itself.
#   SYLLABUS_CHECK_PROFILE=comprehensive-testing
#   SYLLABUS_CHECK_AI_MAX_REQUESTS=120
#   SYLLABUS_CHECK_AI_MAX_COST_USD=17

# Frontend build (a build-time setting of the static site, not of this server):
#   VITE_API_URL=<staging API URL>/api
# Leave SYLLABUS_CHECK_STAGE_B and SYLLABUS_CHECK_STAGE_C3 unset. Leave SMTP_* empty unless staging mail is wanted (then use a staging mailbox).
