# STAGING environment template. Names and rules only: every <...> is a value the system owner supplies. Never commit a filled copy.
# Create a NEW staging file; do not copy the development server/.env. Check it with:
#   node scripts/vpaa-v2-preflight.cjs --env-file <your staging file>
#   node scripts/credential-readiness.cjs --env-file <your staging file>
NODE_ENV=staging
PORT=<port the Node process listens on behind the proxy>
APP_URL=<staging frontend URL, https>

# Dedicated STAGING database (never the development or production one). A least-privilege user, NOT root, with a non-empty password.
DB_HOST=<staging database host>
DB_NAME=<staging database name>
DB_USER=<least-privilege staging user>
DB_PASS=<non-empty password>
# The database server must allow packets of at least 16 MB (max_allowed_packet=16M): a checking report is stored in one statement. See docs/deployment/DATABASE-REQUIREMENTS.md.

# Signing secrets: 32+ random characters each, different from each other and from every other environment.
SESSION_SECRET=<new>
# JWT_SECRET is no longer used: the server makes no sign-in token (SEC-16).

# Host layer (see docs/vpaa-conformance/POLICY-V2-ACTIVATION.md section 2a). No domain is built into the code.
CORS_ALLOWED_ORIGINS=<the staging FRONTEND origin: https://host[:port], no path, no trailing slash>
TRUST_PROXY=<number of reverse-proxy hops in front of this server, usually 1>
SESSION_COOKIE_SAMESITE=<lax if the frontend and the API share a site; none only if they do not>

# The AI Checker on Claude Sonnet 5.5 (see server/.env.example for every AI Checker setting). The server does not start without the cost cap.
SYLLABUS_CHECK_AI_PROVIDER=anthropic
SYLLABUS_CHECK_REPLAN=official
SYLLABUS_CHECK_REPLAN_MAX_COST_USD=2
SYLLABUS_CHECK_REPLAN_MAX_REQUESTS=120
ANTHROPIC_API_KEY=<a NEW staging key, in its own workspace, with a HARD spend limit set at the provider>
ANTHROPIC_MODEL=claude-sonnet-5-5
SYLLABUS_CHECK_ANTHROPIC_APPROVED_MODEL=claude-sonnet-5-5
SYLLABUS_CHECK_AI_GATE=advisory

# Frontend build (a build-time setting of the static site, not of this server):
#   VITE_API_URL=<staging API URL>/api (the rebuilt Syllabus Builder is the default; leave VITE_NEW_BUILDER unset)
# Leave SMTP_* empty unless staging mail is wanted (then use a staging mailbox).

# Where files are kept. Put both on a persistent volume and back both up; without these settings they live under server/ and a redeploy may lose them.
# An absolute path is used as it is; a relative one is a folder under server/.
# UPLOAD_DIR=/data/uploads
# PRIVATE_DIR=/data/private

# Failed sign-in limits (server/lib/signInLimits.js). A correct sign-in is never counted. These cannot be turned off: 0, "off" or a value out of range
# stops the server at startup. Leave them unset to use the defaults shown. The address counted is the one the reverse proxy reports, so TRUST_PROXY must be right.
#   failed password sign-ins for one account in one window (3 to 100)
# SIGNIN_MAX_FAILURES_PER_ACCOUNT=10
#   failed password sign-ins, and separately failed Google sign-ins, from one address in one window (5 to 10000)
# SIGNIN_MAX_FAILURES_PER_IP=50
#   the length of the window in minutes (1 to 1440)
# SIGNIN_WINDOW_MINUTES=15

# Database connection (server/lib/dbConfig.js). In staging and production DB_HOST, DB_USER, DB_PASS and DB_NAME are all required, DB_USER may not be root,
# and the server reads its own grants before it listens: the application account may only SELECT, INSERT, UPDATE and DELETE on its own database, or the
# server does not start. Run the scripts in server/db/ (init.js, migrate-*.js, create-admin.js) with a separate account that may also CREATE and ALTER, by
# setting DB_USER and DB_PASS for that command only. The server also refuses to start while any account still has a demo password from db/seed.sql.
#   the database port (default 3306)
# DB_PORT=3306
#   off | required. required encrypts the connection and verifies the database server. It is REQUIRED in staging and production when DB_HOST is another machine.
# DB_SSL=required
#   the CA certificate file that signed the database server's certificate (only with DB_SSL=required; leave unset for a public CA)
# DB_SSL_CA=
#   connections kept open (1 to 100, default 10) and requests that may wait for one (1 to 10000, default 200)
# DB_POOL_SIZE=10
# DB_POOL_QUEUE=200

# Daily ceilings on AI requests (server/lib/aiQuota.js), counted per calendar day in the Philippines. They cannot be turned off; a bad value stops the server.
#   AI checks (with AI checking on in Settings) by one person, by everyone together, and "Check & improve" requests by one person
# AI_CHECKS_PER_USER_PER_DAY=40
# AI_CHECKS_PER_DAY=400
# AI_REFINES_PER_USER_PER_DAY=60

# Strict SQL mode (server/lib/dbConfig.js): off | on. on refuses a value that is too long or of the wrong type instead of cutting it. Turn it on only after
# the full browser E2E has passed against a strict database; once on, the server checks at startup that it took effect.
# DB_SQL_STRICT=off

# How many days a password the system generates (new account, "Resend credentials", db/create-admin.js) works if it is not replaced. 1 to 90.
# GENERATED_PASSWORD_DAYS=7

# Where sessions are kept (server/lib/sessionStore.js): memory | mysql. Staging and production always use mysql (memory is refused); run
# "npm run migrate-session-store" first. Development uses memory unless this says mysql.
# SESSION_STORE=mysql
