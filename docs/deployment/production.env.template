# PRODUCTION environment template. Names and rules only. Not authorized for use: production deployment needs separate written authorization (docs/deployment/RUNBOOK.md).
NODE_ENV=production
PORT=<port behind the proxy>
APP_URL=<production frontend URL, https>
DB_HOST=<production database host>
DB_NAME=<production database name>
DB_USER=<least-privilege production user, not root>
DB_PASS=<non-empty, unique>
SESSION_SECRET=<new, unique to production>
JWT_SECRET=<new, unique to production>
CORS_ALLOWED_ORIGINS=<the production FRONTEND origin(s), https>
TRUST_PROXY=<reverse-proxy hops>
SESSION_COOKIE_SAMESITE=<lax or none, as in staging>
SMTP_HOST=<production mail relay>
SMTP_PORT=587
SMTP_USER=<...>
SMTP_PASS=<a NEW credential, never one that appeared in a chat>
MAIL_FROM=<...>
GOOGLE_CLIENT_ID=<if Google sign-in is used>

# Policy V2 and the Anthropic provider stay OFF in production until the owner approves them after a live staging test:
SYLLABUS_CHECK_ACADEMIC_V2=off
# If approved later, use its OWN production Anthropic key with its own provider-side spend limit, and the same caps as staging:
#   SYLLABUS_CHECK_AI_PROVIDER=anthropic, ANTHROPIC_API_KEY, ANTHROPIC_MODEL=claude-sonnet-5-5, SYLLABUS_CHECK_ANTHROPIC_APPROVED_MODEL=claude-sonnet-5-5,
#   SYLLABUS_CHECK_AI_GATE=advisory, SYLLABUS_CHECK_AI_MAX_REQUESTS=120, SYLLABUS_CHECK_AI_MAX_COST_USD=10
# Frontend build: VITE_API_URL=<production API URL>/api
