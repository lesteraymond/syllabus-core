# SYLLABUS_CHECK_GENERATE_MAX_REQUESTS=40
# SYLLABUS_CHECK_GENERATE_PER_USER_PER_DAY=3
# SYLLABUS_CHECK_GENERATE_REFERENCES=on
# SYLLABUS_CHECK_TITLE_POLICY=strict
# COR_SCAN_MODEL=claude-haiku-5-5
# ANTHROPIC_THINKING=off
# ANTHROPIC_EFFORT=
# ANTHROPIC_MAX_TOKENS=16000
# ANTHROPIC_TIMEOUT_SEC=120
# ANTHROPIC_MAX_RETRIES=2
# ANTHROPIC_PROMPT_CACHE=on
# SYLLABUS_PDF_IMPORT=on
# SYLLABUS_PDF_IMPORT_CONCURRENCY=2
# SCHOOL_YEAR_START=2026
# USAGE_TRACKING=on
# DEADLINE_NOTICES=on
# DEADLINE_CHECK_MS=900000
# COMPLIANCE_AI_PROVIDER=

