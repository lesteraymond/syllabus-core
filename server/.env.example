DB_HOST=edit_me
DB_USER=edit_me
DB_PASS=edit_me
DB_NAME=edit_me
SESSION_SECRET=edit_me
PORT=edit_me
UPLOAD_DIR=edit_me

GOOGLE_CLIENT_ID=edit_me
JWT_SECRET=edit_me

# Email (credentials and temporary passwords). Leave SMTP_HOST empty to send nothing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Syllabus Management System <no-reply@example.edu.ph>"
APP_URL=http://localhost:5173

# AI Checker recommendations (optional). With an OpenRouter key set, the AI step writes its recommendations with OpenRouter (a free
# model by default); else with a Gemini key, Gemini; without either it uses the built-in rule-based text. COMPLIANCE_AI_PROVIDER=off
# turns the AI step off, =mock forces the offline text, =gemini or =openrouter picks one when both keys are set.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
COMPLIANCE_AI_PROVIDER=

# COR scan for testing: ocr reads the photo with Tesseract instead of the AI (leave unset for the AI)
# COR_READER=ocr

# Developer rule editor: open http://localhost:PORT/dev/rules and enter this password. At least 8 characters; leave empty to keep the editor off.
DEV_EDITOR_PASSWORD=
