DB_HOST=edit_me
DB_USER=edit_me
DB_PASS=edit_me
DB_NAME=edit_me
SESSION_SECRET=edit_me
PORT=edit_me
UPLOAD_DIR=edit_me

GOOGLE_CLIENT_ID=edit_me
JWT_SECRET=edit_me

# Email (credentials and temporary passwords). Leave SMTP_HOST empty to send nothing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Syllabus Management System <no-reply@example.edu.ph>"
APP_URL=http://localhost:5173

# AI Checker recommendations (optional). The AI step uses Groq (GROQ_MODEL) when a Groq key is set, else OpenRouter (OPENROUTER_MODEL), else
# Gemini; without any key it uses the built-in rule-based text. COMPLIANCE_AI_PROVIDER=off turns the AI step off, =mock forces the offline text,
# =groq, =openrouter or =gemini picks one when several keys are set.
GROQ_API_KEY=
# The Groq model id is required (no default), for example llama-3.3-70b-versatile; blank = an error in the console and no AI step.
GROQ_MODEL=
OPENROUTER_API_KEY=
# The OpenRouter model id is required (no default): leave it blank and the AI step is skipped with an error in the console.
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
COMPLIANCE_AI_PROVIDER=

# COR scan for testing: ocr reads the photo with Tesseract instead of the AI (leave unset for the AI)
# COR_READER=ocr

# Developer rule editor: open http://localhost:PORT/dev/rules and enter this password. At least 8 characters; leave empty to keep the editor off.
DEV_EDITOR_PASSWORD=
