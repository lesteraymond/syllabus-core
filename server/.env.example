DB_HOST=edit_me
DB_USER=edit_me
DB_PASS=edit_me
DB_NAME=edit_me
SESSION_SECRET=edit_me
PORT=edit_me
UPLOAD_DIR=edit_me

GOOGLE_CLIENT_ID=edit_me
# JWT_SECRET is no longer used: the server makes no sign-in token (SEC-16). Delete it from your .env.

# Email (credentials and temporary passwords). Leave SMTP_HOST empty to send nothing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Syllabus Management System <no-reply@example.edu.ph>"
APP_URL=http://localhost:5173
SYLLABUS_CHECK_AI_PROVIDER=anthropic
# official = the AI Checker makes the official AI findings, points (at most 5 per area) and drafts. shadow and plan only attach a comparison.
SYLLABUS_CHECK_REPLAN=official
# The most one AI check may spend, in US dollars (required: nothing is sent without it; at most 1000). In staging and production the server does not
# start without it once an AI provider is configured (server/lib/aiQuota.js).
SYLLABUS_CHECK_REPLAN_MAX_COST_USD=2
# Requests per check (1-300, default 80). A full repair plan on a long syllabus can need more than 80, so 120 is suggested.
SYLLABUS_CHECK_REPLAN_MAX_REQUESTS=120
SYLLABUS_CHECK_AI_GATE=advisory
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
SYLLABUS_CHECK_ANTHROPIC_APPROVED_MODEL=
SYLLABUS_PDF_IMPORT=on
