DB_HOST=edit_me
DB_USER=edit_me
DB_PASS=edit_me
DB_NAME=edit_me
SESSION_SECRET=edit_me
PORT=edit_me
UPLOAD_DIR=edit_me

GOOGLE_CLIENT_ID=edit_me
JWT_SECRET=edit_me

# Email (credentials and temporary passwords). Leave SMTP_HOST empty to send nothing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Syllabus Management System <no-reply@example.edu.ph>"
APP_URL=http://localhost:5173

# Hybrid checker. OpenRouter Nemotron (free) is the configured model below.
# SYLLABUS_CHECK_AI_PROVIDER=off turns the AI off whatever keys are set: no AI request is sent, the coded rules still run, and each check says
# that the AI is off (with SYLLABUS_CHECK_AI_GATE=required, submission then stays blocked).
SYLLABUS_CHECK_AI_PROVIDER=openrouter
# Who has the final say on a submit or an approval.
#   advisory (default): the AI result and its recommendations are advice. The author and the administrator decide, and only the coded
#                       hard gates (course in the curriculum, grading total, standard sections) stop a submit.
#   required:           a completed, current AI check is also needed first.
SYLLABUS_CHECK_AI_GATE=advisory
# Re-checks only ask the AI about what changed: a relationship whose text, prompt version and model are unchanged keeps its earlier
# verified judgement from this syllabus's own previous checks. Set to off to ask the AI about everything every time.
SYLLABUS_CHECK_REUSE=on
# How relationships are sent to the AI. A call is mostly fixed overhead (about 3 s for 4 relationships, 5.4 s for 12 on the free model),
# so fewer, larger calls run a few at a time are much faster. Defaults: 8 per call on the free Nemotron model, 12 otherwise, 3 at once.
# Lower them if the provider rate-limits (HTTP 429) or truncates answers.
#SYLLABUS_CHECK_AI_BATCH=8
#SYLLABUS_CHECK_AI_CONCURRENCY=3
# Per Re-Check limits include all relationship batches and provider retries. The token budget reserves UTF-8 request bytes plus maximum output tokens.
# Increase these only when large syllabus checks need more capacity; an exhausted budget leaves unanswered relationships NOT_CHECKED.
#SYLLABUS_CHECK_AI_MAX_REQUESTS=512
#SYLLABUS_CHECK_AI_MAX_TOKENS=8000000
# Cost controls for the direct Anthropic path (server/lib/syllabuscheck/costPlan.js; all OFF by default, so requests are exactly what they were; none
# changes a rule, the official score, the 79 threshold or a gate; see docs/checker-comprehensive/optimization/OPTIMIZATION-REPORT.md):
#   SYLLABUS_CHECK_COURSE_CONTEXT=scoped   send the course description only with the relationship types that read it (cuts re-asks after a description edit)
#   SYLLABUS_CHECK_OUTPUT_PLAN=on          size max_tokens (and the budget reservation) from the request, never above ANTHROPIC_MAX_TOKENS
#   SYLLABUS_CHECK_CACHE_WARMUP=on         send the first request of each cacheable prompt alone so the others read the prompt cache
#   SYLLABUS_CHECK_V2_GROUPING=week1|week2|week3|adaptive   EXPERIMENTAL: batch Policy V2 relationships by week (week3 is near the output ceiling)
#SYLLABUS_CHECK_COURSE_CONTEXT=scoped
#SYLLABUS_CHECK_OUTPUT_PLAN=on
#SYLLABUS_CHECK_OUTPUT_FIELDS=scoped
#SYLLABUS_CHECK_CACHE_WARMUP=on
#SYLLABUS_CHECK_V2_GROUPING=default
# Advisory checking stages (all OFF by default; advice only, they never change a score, a deduction or a gate):
#   A course/CLO/PO-EGA, B weekly content and ILO, B3 ILO-CLO mapping, B4 CLO coverage, C1 activities, C2 assessments,
#   D1 Marian-Augustinian values, D2 APA 7 references. See docs/stage-e-audit.md.
#SYLLABUS_CHECK_STAGE_A=off
#SYLLABUS_CHECK_STAGE_B=off
#SYLLABUS_CHECK_STAGE_B3=off
#SYLLABUS_CHECK_STAGE_B4=off
#SYLLABUS_CHECK_STAGE_C1=off
#SYLLABUS_CHECK_STAGE_C2=off
#SYLLABUS_CHECK_STAGE_D1=off
#SYLLABUS_CHECK_STAGE_D2=off
# Policy V2 + LCUP CLO classifications + r2 recommendations in the saved AI Checker report (advisory only; requires approved Claude configuration).
SYLLABUS_CHECK_ACADEMIC_V2=off
# Course-title comparison: shadow (default; official stays exact, the normalised decision is reported beside it), exact, or normalized
# (capitalisation, Unicode form and spacing only; never fuzzy). normalized is OFFICIAL and changes submission: activate only with approval,
# following docs/title-policy-activation.md.
#SYLLABUS_CHECK_TITLE_POLICY=shadow
# After a wrong course code the AI does not run. on = provisional, clearly labelled AI feedback that never counts officially (keep off).
#SYLLABUS_CHECK_PROVISIONAL_AI=off
# A lesson naming no core value: the checker no longer picks one. legacy restores the old template suggestion (rollback only).
#SYLLABUS_CHECK_VALUE_SUGGESTION=review
# Optional files: the institution's value definitions (default server/config/marian-values.json, pending approval) and the proposed
# supporting-value vocabulary (default server/config/values-lexicon.json).
#SYLLABUS_CHECK_VALUES_FILE=
#SYLLABUS_CHECK_VALUES_LEXICON=
# Optional DOI lookup at Crossref for reference authenticity (off by default; a DOI missing there is reviewed, never rejected).
#SYLLABUS_CHECK_REF_VERIFY=off
# Shortened prompt (only with a stage on). NOT approved: the full prompt is the baseline until the two are compared.
#SYLLABUS_CHECK_PROMPT_TRIM=off
# Ask the provider for a non-empty judgements list (JSON Schema minItems: 1; only with a stage on, on a paid OpenRouter model). NOT approved:
# whether the provider enforces it is unmeasured, and an empty answer is still refused and corrected as before. See docs/stage-e6-evaluation-reliability.md.
#SYLLABUS_CHECK_SCHEMA_MIN_ITEMS=off
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter checker: set SYLLABUS_CHECK_AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Also supported: any google/gemini-* model

# Anthropic checker (direct Claude API, paid, EXPERIMENTAL): set SYLLABUS_CHECK_AI_PROVIDER=anthropic. Off unless chosen by name; a key alone never selects it.
# It needs both values below: an sk-ant- key (a key in any other format is never sent) and a verified model id: claude-sonnet-5-5 (the evaluation
# candidate), claude-haiku-5-5, claude-opus-5-5, claude-fable-5-1, claude-opus-5, claude-sonnet-5 or claude-sonnet-4-6. Any other id sends nothing.
# Even then the application sends nothing until SYLLABUS_CHECK_ANTHROPIC_APPROVED_MODEL names that same model: adding a valid key turns nothing on.
# Set the approval only once Claude has been evaluated and approved for official checking (docs/anthropic-direct-api-plan.md). From then on every
# AI check and AI rewrite makes paid requests. The key stays on the server: never put it in a VITE_ variable or commit it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
#SYLLABUS_CHECK_ANTHROPIC_APPROVED_MODEL=
# Deadline of one request in seconds (10-300, default 180). A request that timed out, or that the API answered with 504, is never sent again
# (it may already be billed).
#ANTHROPIC_TIMEOUT_SEC=180
# Retries after a rate limit (429), an overload (529), a server error (500, 502, 503) or a dropped connection (0-3, default 2), within the deadline.
# A spend limit or an exhausted credit balance is never retried.
#ANTHROPIC_MAX_RETRIES=2
# Longest answer in tokens (1024-16000, default 16000). Thinking counts against it and is billed as output.
#ANTHROPIC_MAX_TOKENS=16000
# Thinking: adaptive (default) or off. off sends between_tools on claude-sonnet-5-5 and disabled on the others; claude-opus-5-5 and
# claude-fable-5-1 cannot turn thinking off, so with off they send nothing.
#ANTHROPIC_THINKING=adaptive
# Effort: low, medium, high, xhigh or max (unset = the model's default, which is then sent explicitly: high on claude-sonnet-5-5). xhigh and max need
# thinking on, and claude-sonnet-4-6 has no xhigh; a combination the API would refuse sends nothing.
#ANTHROPIC_EFFORT=
# The system prompt is cached for 5 minutes, so a check's later requests read it at a lower price. off turns that off.
#ANTHROPIC_PROMPT_CACHE=on

# PDF import is enabled by default. Set to off to disable preview extraction.
# PDFs are private in-memory imports; AI CHECK remains an explicit action.
SYLLABUS_PDF_IMPORT=on
